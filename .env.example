# --- Blog post likes ---

# Turso (libsql) connection. Set both on Vercel (Production *and* Preview). Leave unset
# locally to fall back to a file-backed sqlite db at ./data/portfolio.db via the same
# @libsql/client driver (file: URL) — no better-sqlite3 / bun:sqlite needed.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Secret key for hashing visitor IPs into anonymous like-tracking ids (HMAC-SHA256).
# Required in production -- without it the server falls back to a public, insecure
# dev-only salt and logs a warning. Generate with: openssl rand -hex 32
LIKES_HASH_SALT=

# Set to "true" only if you deploy behind a reverse proxy that overwrites the
# x-forwarded-for / x-real-ip headers. On Vercel this is unnecessary -- the platform sets
# VERCEL=1 and is trusted automatically. Off-platform, forwarding headers are ignored and
# the socket address is used, because a forgeable header would let one visitor mint
# unlimited identities and blow past the per-visitor like cap.
TRUST_PROXY_HEADERS=
