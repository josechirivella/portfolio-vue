# --- Blog post likes ---

# Turso (libsql) connection. Set both on Vercel (Production *and* Preview) — Preview
# env is separate from Production. Exact names the app reads (via runtimeConfig):
#   TURSO_DATABASE_URL → tursoDatabaseUrl
#   TURSO_AUTH_TOKEN   → tursoAuthToken
#   LIKES_HASH_SALT    → likesHashSalt
# (NUXT_TURSO_DATABASE_URL / NUXT_TURSO_AUTH_TOKEN / NUXT_LIKES_HASH_SALT also work.)
# Leave TURSO_* unset locally to fall back to ./data/portfolio.db via @libsql/client/node.
# On Vercel, missing Turso does *not* fall back to a file DB (ephemeral FS) — API 503s.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Secret key for hashing visitor IPs into anonymous like-tracking ids (HMAC-SHA256).
# Required on Vercel (Preview + Production): missing salt fails closed with 503.
# Locally, unset falls back to a public insecure salt and logs a warning.
# Generate with: openssl rand -hex 32
LIKES_HASH_SALT=

# Set to "true" only if you deploy behind a reverse proxy that overwrites the
# x-forwarded-for / x-real-ip headers. On Vercel this is unnecessary -- the platform sets
# VERCEL=1 and is trusted automatically. Off-platform, forwarding headers are ignored and
# the socket address is used, because a forgeable header would let one visitor mint
# unlimited identities and blow past the per-visitor like cap.
TRUST_PROXY_HEADERS=
